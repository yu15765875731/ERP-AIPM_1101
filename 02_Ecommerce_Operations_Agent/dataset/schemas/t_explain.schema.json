{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project2_EcommerceOpsAgent_T_EXPLAIN_Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_revision",
    "reported_delta_cm1",
    "covers_limitations",
    "claims",
    "limitations",
    "proposed_checks",
    "external_execution"
  ],
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "reported_delta_cm1": {
      "type": [
        "string",
        "null"
      ]
    },
    "covers_limitations": {
      "type": "boolean"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "kind",
          "text",
          "result_refs",
          "value_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "FACT",
              "ASSUMPTION"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "result_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "value_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "proposed_checks": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_to_verify",
          "suggested_owner_role",
          "evidence_refs"
        ],
        "properties": {
          "question_to_verify": {
            "type": "string"
          },
          "suggested_owner_role": {
            "enum": [
              "SHOP_OPERATOR",
              "AD_OPTIMIZER",
              "FINANCE_LIAISON",
              "BUSINESS_OWNER"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "external_execution": {
      "const": "NOT_AVAILABLE"
    }
  }
}
